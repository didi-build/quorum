{
  "name": "quorum",
  "version": "0.0.0",
  "private": true,
  "description": "Group decisions by AI seats that reach a consensus recommendation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "npm run conflict-markers && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run gallery:guards && npm run gallery:build && npm run build:frontend && npm run secrets && npm run secret-usage && npm run placeholders && npm run attribution && npm run deploy:guards && npm run workflow-d1-id-secrets && npm run nodrift",
    "gallery:guards": "node scripts/check-gallery-guards.mjs",
    "gallery:build": "node scripts/build-gallery.mjs",
    "dev:gallery": "vite --config frontend/vite.gallery.config.ts",
    "deploy:guards": "node scripts/check-deploy-guards.mjs --target committed --config wrangler.jsonc",
    "workflow-d1-id-secrets": "node scripts/check-workflow-d1-id-secrets.mjs",
    "dev": "npm run build:frontend && wrangler dev",
    "build:frontend": "node scripts/build-frontend.mjs production",
    "build:frontend:mock-preview": "node scripts/build-frontend.mjs mock-preview",
    "build": "npm run build:frontend",
    "test:worker": "npm run build:frontend && vitest run --config vitest.worker.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p test/worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets": "secretlint \"**/*\"",
    "conflict-markers": "node scripts/check-conflict-markers.mjs",
    "secret-usage": "node scripts/check-secret-usage.mjs",
    "placeholders": "node scripts/check-placeholders.mjs",
    "attribution": "node scripts/check-attribution.mjs",
    "nodrift": "node scripts/run-nodrift-check.mjs",
    "init-project": "node scripts/init-project.mjs",
    "repo-settings": "node scripts/repo-settings.mjs",
    "verify-action-pins": "node scripts/verify-action-pins.mjs",
    "capture-preview-screenshots": "node scripts/capture-preview-screenshots.mjs",
    "eval:router": "tsx scripts/eval-router.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "node scripts/check-conflict-markers.mjs",
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "globby": {
      "ignore": "7.0.12"
    },
    "p-map": "7.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.10.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@didi-build/nodrift": "0.1.0",
    "@eslint/js": "9.39.5",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@playwright/test": "1.64.1",
    "@secretlint/secretlint-rule-preset-recommend": "10.2.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.37.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jsdom": "26.1.0",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "secretlint": "10.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.1.9",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "3.2.7",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.78.0",
    "js-tiktoken": "1.0.21",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
