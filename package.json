{
  "name": "quorum",
  "version": "0.0.0",
  "private": true,
  "description": "Group decisions by AI seats that reach a consensus recommendation.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "npm run conflict-markers && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run secrets && npm run secret-usage && npm run placeholders && npm run attribution",
    "dev": "npm run build:frontend && wrangler dev",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "build": "npm run build:frontend",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets": "secretlint \"**/*\"",
    "conflict-markers": "node scripts/check-conflict-markers.mjs",
    "secret-usage": "node scripts/check-secret-usage.mjs",
    "placeholders": "node scripts/check-placeholders.mjs",
    "attribution": "node scripts/check-attribution.mjs",
    "nodrift": "node scripts/run-nodrift-check.mjs",
    "init-project": "node scripts/init-project.mjs",
    "repo-settings": "node scripts/repo-settings.mjs",
    "verify-action-pins": "node scripts/verify-action-pins.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "node scripts/check-conflict-markers.mjs",
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@didi-build/nodrift": "0.1.0",
    "@eslint/js": "9.39.5",
    "@secretlint/secretlint-rule-preset-recommend": "10.2.2",
    "@types/node": "22.20.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "9.37.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "secretlint": "10.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "3.2.7",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
