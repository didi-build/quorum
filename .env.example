# Copy to `.env` for local development. Names only — never put real values in git.
# Document each variable in README or docs/architecture/ when you add one.

# EXAMPLE_API_URL=

# Frontend dev-only auth mock (until DIDI-772). Set VITE_AUTH_MOCK=true when running vite.
# VITE_AUTH_MOCK_USER=diadem
# VITE_AUTH_MOCK_ACCESS_DENIED=sam-rivera

# Frontend dev only: mock chat WebSocket and history (default on in dev). Set to false for live endpoints.
# VITE_CHAT_MOCK=false

# init-project / Bootstrap (non-interactive): true | false
# LAUNCHPAD_COLLECTS_PERSONAL_DATA=
