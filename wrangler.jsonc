{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quorum",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // Placeholder resource ids only; real ids come from Manual Cloudflare setup tickets.
  "vars": {
    "APP_ENV": "development",
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quorum-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "INDEXING_QUEUE",
        "queue": "quorum-indexing",
      },
    ],
    "consumers": [
      {
        "queue": "quorum-indexing",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
      },
    ],
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "quorum-embeddings",
    },
  ],
}
